# ============================================================
# OPTIONAL — Dhan credentials for LIVE MARKET DATA only.
#
# You do NOT need these to try the project. Run it fully offline with:
#     python run_paper.py --demo
#
# Add them only if you want the paper engine to trade against REAL live prices
# (requires a Dhan Data API subscription). v1 ships no live-order broker, so
# these keys can never place a real order — they are read-only market data here.
#
# Setup: copy this file to `.env` and paste your values.
# Get them in the Dhan app/web: Profile -> DhanHQ Trading APIs -> generate token.
# `.env` is gitignored — never commit it, never share it.
# ============================================================
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
